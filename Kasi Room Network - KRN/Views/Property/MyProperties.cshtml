@using System.Linq
@model IEnumerable<KasiRoomNetwork.Common.ViewModel.Landlord.PropertyCardViewModel>

@{
    ViewData["Title"] = ViewBag.Mode == "addlisting" ? "Add Room Listing" : "My Properties";
    var properties = Model?.ToList() ?? new List<KasiRoomNetwork.Common.ViewModel.Landlord.PropertyCardViewModel>();
    var isAddingListing = ViewBag.Mode == "addlisting";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/property-management-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/property-management-views.css" asp-append-version="true" />
}

<div class="management-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show management-alert" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="management-page-header">
        <div>
            @if (isAddingListing)
            {
                <a asp-controller="Landlord" asp-action="LandlordDashboard" class="management-back-link">
                    <i class="bi bi-arrow-left"></i> Back to property management
                </a>
            }
            <span class="dashboard-section-kicker">@(isAddingListing ? "Room listings" : "Property portfolio")</span>
            <h1 class="management-page-title">@(isAddingListing ? "Choose a property" : "My properties")</h1>
            <p class="management-page-subtitle">@(isAddingListing ? "Select where you want to add a new room listing." : "Manage your properties and the rooms listed within them.")</p>
        </div>
        @if (!isAddingListing)
        {
            <a asp-controller="Property" asp-action="CreateProperty" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-building-add me-2"></i>Add property
            </a>
        }
    </header>

    @if (!properties.Any())
    {
        <section class="management-empty-state">
            <div class="dashboard-empty-icon"><i class="bi bi-building-add"></i></div>
            <h2 class="h5 fw-bold">No properties yet</h2>
            <p class="text-muted mb-4">Create your first property to start building your room portfolio.</p>
            <a asp-controller="Property" asp-action="CreateProperty" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-2"></i>Create property
            </a>
        </section>
    }
    else
    {
        <div class="management-grid">
            @foreach (var property in properties)
            {
                <article class="management-card">
                    <div class="management-card-image">
                        <img src="@(string.IsNullOrWhiteSpace(property.PrimaryPhoto) ? "/images/no-image.png" : property.PrimaryPhoto)"
                             alt="@property.PropertyName" />
                        <span class="management-card-image-label"><i class="bi bi-building me-1"></i>Property</span>
                    </div>
                    <div class="management-card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <h2 class="management-card-title">@property.PropertyName</h2>
                                <p class="management-card-meta mb-1"><i class="bi bi-building me-1"></i>@PropertyTypeDisplay.GetDisplayName(property.PropertyType)</p>
                            </div>
                            <span class="management-card-count">@property.TotalListings <small>listing@(property.TotalListings == 1 ? "" : "s")</small></span>
                        </div>
                        <p class="management-card-meta mb-3"><i class="bi bi-geo-alt me-1"></i>@property.Street, @property.Suburb, @property.City</p>
                        <div class="management-stat-row">
                            <span><strong>@property.TotalRooms</strong> total room@(property.TotalRooms == 1 ? "" : "s")</span>
                            <span>Added @property.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="management-card-actions">
                            @if (isAddingListing)
                            {
                                <a asp-controller="Listing" asp-action="CreateListing" asp-route-propertyId="@property.PropertyId" class="btn btn-primary rounded-pill flex-grow-1">
                                    <i class="bi bi-plus-circle me-1"></i>Add room
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Property" asp-action="PropertyDetails" asp-route-propertyId="@property.PropertyId" class="btn btn-primary rounded-pill flex-grow-1">
                                    <i class="bi bi-arrow-up-right me-1"></i>Open property
                                </a>
                                <a asp-controller="Listing" asp-action="CreateListing" asp-route-propertyId="@property.PropertyId" class="btn btn-outline-success rounded-pill">
                                    <i class="bi bi-plus-circle me-1"></i>Add room
                                </a>
                            }
                        </div>
                        @if (!isAddingListing)
                        {
                            <form asp-controller="Property" asp-action="DeleteProperty" method="post" class="mt-2" onsubmit="return confirm('Are you sure you want to delete this property? This action cannot be undone.');">
                                <input type="hidden" name="propertyId" value="@property.PropertyId" />
                                <button type="submit" class="btn btn-link btn-sm text-danger text-decoration-none w-100">
                                    <i class="bi bi-trash me-1"></i>Delete property
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>
