@using System.Linq
@model KasiRoomNetwork.Common.ViewModel.Properties.PropertyDetailsViewModel

@functions {
    private static string GetPhotoUrl(string? photoPath)
    {
        if (string.IsNullOrWhiteSpace(photoPath))
        {
            return string.Empty;
        }

        var trimmedPath = photoPath.Trim().Replace("\\", "/");
        if (trimmedPath.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || trimmedPath.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
            || trimmedPath.StartsWith("/"))
        {
            return trimmedPath;
        }

        return "/" + trimmedPath.TrimStart('~', '/');
    }
}

@{
    ViewData["Title"] = "Property Details";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var canEditProperty = User.IsInRole("Landlord") && currentUserId == Model.LandlordUserId;
    var photos = (Model.Photos ?? new List<KasiRoomNetwork.Common.ViewModel.Properties.PropertyPhotoViewModel>())
        .Where(photo => !string.IsNullOrWhiteSpace(photo.PhotoPath))
        .OrderByDescending(photo => photo.IsPrimary)
        .ThenBy(photo => photo.PhotoId)
        .ToList();
}

@section Styles
{
    <link rel="stylesheet" href="~/css/property-management-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/property-management-views.css" asp-append-version="true" />
}

<div class="management-page property-workspace">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show management-alert" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show management-alert" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <a asp-controller="Property" asp-action="MyProperties" class="management-back-link">
        <i class="bi bi-arrow-left"></i> Back to properties
    </a>

    <header class="property-workspace-header">
        <div>
            <span class="dashboard-section-kicker">Property workspace</span>
            <h1 class="management-page-title">@Model.PropertyName</h1>
            <p class="management-page-subtitle mb-2"><i class="bi bi-geo-alt me-1"></i>@Model.Street, @Model.Suburb, @Model.City, @Model.Province</p>
            <span class="dashboard-tag"><i class="bi bi-building me-1"></i>@PropertyTypeDisplay.GetDisplayName(Model.PropertyType)</span>
        </div>
        @if (canEditProperty)
        {
            <a asp-controller="Listing" asp-action="CreateListing" asp-route-propertyId="@Model.PropertyId" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-circle me-2"></i>Add room
            </a>
        }
    </header>

    @if (canEditProperty)
    {
        @if (!Model.IsVerified && !string.IsNullOrWhiteSpace(Model.VerificationNotes))
        {
            <div class="workspace-status workspace-status-danger mb-4">
                <i class="bi bi-exclamation-circle-fill"></i>
                <div><strong>Changes required</strong><span>@Model.VerificationNotes</span></div>
            </div>
        }
        else if (!Model.IsVerified)
        {
            <div class="workspace-status workspace-status-warning mb-4">
                <i class="bi bi-hourglass-split"></i>
                <div><strong>Under review</strong><span>We are reviewing your property. Make sure the details are up to date.</span></div>
            </div>
        }
        else
        {
            <div class="workspace-status workspace-status-success mb-4">
                <i class="bi bi-check-circle-fill"></i>
                <div><strong>Property approved</strong><span>Your property is ready for room listings.</span></div>
            </div>
        }
    }

    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-7">
            @if (photos.Any())
            {
                <div id="propertyCarousel" class="property-gallery carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (var i = 0; i < photos.Count; i++)
                        {
                            var photo = photos[i];
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@GetPhotoUrl(photo.PhotoPath)" class="d-block w-100" alt="@(photo.IsPrimary ? "Primary property photo" : "Property photo")" />
                            </div>
                        }
                    </div>
                    @if (photos.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev" aria-label="Previous property photo">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next" aria-label="Next property photo">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        </button>
                    }
                    @if (canEditProperty)
                    {
                        <a asp-controller="Property" asp-action="ManagePropertyPhotos" asp-route-propertyId="@Model.PropertyId" class="property-gallery-action btn btn-light btn-sm rounded-pill">
                            <i class="bi bi-images me-1"></i>Manage photos
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="management-empty-state property-gallery-empty">
                    <div class="dashboard-empty-icon"><i class="bi bi-image"></i></div>
                    <h2 class="h6 fw-bold">No property photos yet</h2>
                    <p class="text-muted mb-3">Add photos to make this property easier to recognise.</p>
                    @if (canEditProperty)
                    {
                        <a asp-controller="Property" asp-action="AddPropertyPhotos" asp-route-propertyId="@Model.PropertyId" class="btn btn-primary btn-sm rounded-pill">
                            <i class="bi bi-cloud-upload me-1"></i>Upload photos
                        </a>
                    }
                </div>
            }
        </div>
        <div class="col-12 col-lg-5">
            <section class="workspace-info-panel h-100" aria-labelledby="property-info-title">
                <div class="workspace-section-heading"><span class="dashboard-section-kicker">Overview</span><h2 id="property-info-title" class="h5">Property information</h2></div>
                <div class="workspace-info-grid">
                    <div><span>Property type</span><strong>@PropertyTypeDisplay.GetDisplayName(Model.PropertyType)</strong></div>
                    <div><span>Total rooms</span><strong>@Model.TotalRooms</strong></div>
                    <div><span>Location</span><strong>@Model.Suburb, @Model.City</strong></div>
                    <div><span>Added</span><strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong></div>
                </div>
            </section>
        </div>
    </div>

    <section class="workspace-info-panel mb-4" aria-labelledby="room-listings-title">
        <div class="workspace-section-heading workspace-section-heading-inline">
            <div>
                <span class="dashboard-section-kicker">Property inventory</span>
                <h2 id="room-listings-title" class="h5">Room listings</h2>
                <p class="text-muted mb-0">Rooms currently listed under this property.</p>
            </div>
            @if (canEditProperty)
            {
                <a asp-controller="Listing" asp-action="CreateListing" asp-route-propertyId="@Model.PropertyId" class="btn btn-sm btn-outline-primary rounded-pill">
                    <i class="bi bi-plus-circle me-1"></i>Add room
                </a>
            }
        </div>

        @if (Model.Listings == null || !Model.Listings.Any())
        {
            <div class="workspace-listings-empty">
                <i class="bi bi-door-open"></i>
                <div>
                    <strong>No room listings yet</strong>
                    <span>Add the first room listing for this property to make it available to tenants.</span>
                </div>
                @if (canEditProperty)
                {
                    <a asp-controller="Listing" asp-action="CreateListing" asp-route-propertyId="@Model.PropertyId" class="btn btn-primary btn-sm rounded-pill">Add first room</a>
                }
            </div>
        }
        else
        {
            <div class="workspace-listings-grid">
                @foreach (var listing in Model.Listings)
                {
                    <article class="workspace-listing-card">
                        <div class="workspace-listing-image">
                            <img src="@(string.IsNullOrWhiteSpace(listing.PrimaryPhoto) ? "/images/no-image.png" : GetPhotoUrl(listing.PrimaryPhoto))" alt="@listing.Title" />
                            <span class="management-status-badge @(listing.IsAvailable ? "management-status-available" : "management-status-occupied")">
                                <i class="bi @(listing.IsAvailable ? "bi-check-circle-fill" : "bi-dash-circle-fill") me-1"></i>
                                @(listing.IsAvailable ? $"{listing.AvailableUnits} available" : "Occupied")
                            </span>
                        </div>
                        <div class="workspace-listing-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h3 class="workspace-listing-title">@listing.Title</h3>
                                @if (listing.IsVerified)
                                {
                                    <span class="management-verification management-verification-approved"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                                }
                                else
                                {
                                    <span class="management-verification management-verification-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                }
                            </div>
                            <div class="workspace-listing-price">R @listing.Price.ToString("N0") <small>/ month</small></div>
                            <div class="workspace-listing-meta"><i class="bi bi-box-seam me-1"></i>@listing.AvailableUnits available unit@(listing.AvailableUnits == 1 ? "" : "s")</div>
                            @if (canEditProperty)
                            {
                                <div class="workspace-listing-actions">
                                    <a asp-controller="Listing" asp-action="MyListingDetails" asp-route-listingId="@listing.ListingId" class="btn btn-primary btn-sm rounded-pill flex-grow-1">View details</a>
                                    <a asp-controller="Listing" asp-action="EditListing" asp-route-listingId="@listing.ListingId" class="btn btn-outline-success btn-sm rounded-pill" aria-label="Edit @listing.Title"><i class="bi bi-pencil-square"></i></a>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    @if (canEditProperty)
    {
        <section class="mb-4" aria-labelledby="manage-property-title">
            <div class="workspace-section-heading"><span class="dashboard-section-kicker">Property operations</span><h2 id="manage-property-title" class="h5">Manage this property</h2></div>
            <div class="workspace-action-grid">
                <a asp-controller="Listing" asp-action="CreateListing" asp-route-propertyId="@Model.PropertyId" class="workspace-action-card">
                    <span class="workspace-action-icon workspace-action-icon-primary"><i class="bi bi-plus-circle"></i></span><strong>Add room</strong><span>Create a new room listing for this property.</span><i class="bi bi-arrow-up-right workspace-action-arrow"></i>
                </a>
                <a asp-controller="Property" asp-action="EditProperty" asp-route-propertyId="@Model.PropertyId" class="workspace-action-card">
                    <span class="workspace-action-icon workspace-action-icon-info"><i class="bi bi-pencil-square"></i></span><strong>Edit property info</strong><span>Update the property name, type and address.</span><i class="bi bi-arrow-up-right workspace-action-arrow"></i>
                </a>
                <a asp-controller="Property" asp-action="ManagePropertyPhotos" asp-route-propertyId="@Model.PropertyId" class="workspace-action-card">
                    <span class="workspace-action-icon workspace-action-icon-warning"><i class="bi bi-images"></i></span><strong>Manage photos</strong><span>Upload, delete or set the primary photo.</span><i class="bi bi-arrow-up-right workspace-action-arrow"></i>
                </a>
                <a asp-controller="Property" asp-action="EditPropertyAmenities" asp-route-propertyId="@Model.PropertyId" class="workspace-action-card">
                    <span class="workspace-action-icon workspace-action-icon-success"><i class="bi bi-stars"></i></span><strong>Edit amenities</strong><span>Add or remove the amenities offered here.</span><i class="bi bi-arrow-up-right workspace-action-arrow"></i>
                </a>
            </div>
        </section>
    }

    @if (Model.Amenities != null && Model.Amenities.Any())
    {
        <section class="workspace-info-panel" aria-labelledby="amenities-title">
            <div class="workspace-section-heading"><span class="dashboard-section-kicker">Property features</span><h2 id="amenities-title" class="h5">Amenities</h2></div>
            @foreach (var categoryGroup in Model.Amenities.GroupBy(amenity => amenity.Category))
            {
                <div class="amenity-group">
                    <h3>@categoryGroup.Key</h3>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var amenity in categoryGroup)
                        {
                            <span class="amenity-pill"><i class="bi bi-check-circle-fill me-1"></i>@amenity.Name</span>
                        }
                    </div>
                </div>
            }
            @if (canEditProperty)
            {
                <a asp-controller="Property" asp-action="EditPropertyAmenities" asp-route-propertyId="@Model.PropertyId" class="btn btn-sm btn-outline-primary rounded-pill mt-2">
                    <i class="bi bi-pencil me-1"></i>Edit amenities
                </a>
            }
        </section>
    }
</div>
