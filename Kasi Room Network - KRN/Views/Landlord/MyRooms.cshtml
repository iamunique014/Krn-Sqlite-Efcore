@using System.Linq
@model IEnumerable<KasiRoomNetwork.Common.ViewModel.Landlord.LandlordListingViewModel>

@{
    ViewData["Title"] = "Room Listings";
    var listings = Model?.ToList() ?? new List<KasiRoomNetwork.Common.ViewModel.Landlord.LandlordListingViewModel>();
    var availableCount = listings.Count(listing => listing.IsAvailable);
    var pendingCount = listings.Count(listing => !listing.IsVerified);
}

@section Styles
{
    <link rel="stylesheet" href="~/css/property-management-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/property-management-views.css" asp-append-version="true" />
}

<div class="management-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show management-alert" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <header class="management-page-header">
        <div>
            <a asp-controller="Landlord" asp-action="LandlordDashboard" class="management-back-link">
                <i class="bi bi-arrow-left"></i> Back to property management
            </a>
            <span class="dashboard-section-kicker">Portfolio operations</span>
            <h1 class="management-page-title">Room listings</h1>
            <p class="management-page-subtitle">Manage availability, verification, pricing and listing photos.</p>
        </div>
        <a asp-controller="Property" asp-action="MyProperties" asp-route-mode="addlisting" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-2"></i>Add room
        </a>
    </header>

    <section class="management-summary-bar" aria-label="Listing summary">
        <div><strong>@listings.Count</strong><span>Total listings</span></div>
        <div><strong>@availableCount</strong><span>Available</span></div>
        <div><strong>@pendingCount</strong><span>Awaiting verification</span></div>
    </section>

    @if (!listings.Any())
    {
        <section class="management-empty-state">
            <div class="dashboard-empty-icon"><i class="bi bi-door-open"></i></div>
            <h2 class="h5 fw-bold">No room listings yet</h2>
            <p class="text-muted mb-4">Choose a property and add your first room listing.</p>
            <a asp-controller="Property" asp-action="MyProperties" asp-route-mode="addlisting" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-circle me-2"></i>Add your first room
            </a>
        </section>
    }
    else
    {
        <div class="management-grid management-grid-listings">
            @foreach (var listing in listings)
            {
                <article class="management-card">
                    <div class="management-card-image">
                        <img src="@(string.IsNullOrWhiteSpace(listing.PrimaryPhoto) ? "/images/no-image.png" : listing.PrimaryPhoto)"
                             alt="@listing.Title" />
                        <span class="management-status-badge @(listing.IsAvailable ? "management-status-available" : "management-status-occupied")">
                            <i class="bi @(listing.IsAvailable ? "bi-check-circle-fill" : "bi-dash-circle-fill") me-1"></i>
                            @(listing.IsAvailable ? $"{listing.AvailableUnits} available" : "Occupied")
                        </span>
                    </div>
                    <div class="management-card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <h2 class="management-card-title">@listing.Title</h2>
                                <p class="management-card-meta mb-1"><i class="bi bi-geo-alt me-1"></i>@listing.Suburb, @listing.City</p>
                            </div>
                            @if (listing.IsVerified)
                            {
                                <span class="management-verification management-verification-approved"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                            }
                            else
                            {
                                <span class="management-verification management-verification-pending"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                            }
                        </div>
                        <div class="management-price">R @listing.Price.ToString("N0") <small>/ month</small></div>
                        <div class="management-stat-row">
                            <span><i class="bi bi-box-seam me-1"></i>@listing.AvailableUnits available unit@(listing.AvailableUnits == 1 ? "" : "s")</span>
                            <span>@listing.Province</span>
                        </div>
                        <div class="management-card-actions">
                            <a asp-controller="Listing" asp-action="MyListingDetails" asp-route-listingId="@listing.ListingId" class="btn btn-primary rounded-pill flex-grow-1">
                                <i class="bi bi-arrow-up-right me-1"></i>View details
                            </a>
                            <a asp-controller="Listing" asp-action="EditListing" asp-route-listingId="@listing.ListingId" class="btn btn-outline-success rounded-pill">
                                <i class="bi bi-pencil-square me-1"></i>Edit
                            </a>
                        </div>
                        <a asp-controller="Listing" asp-action="ManageListingPhotos" asp-route-listingId="@listing.ListingId" class="btn btn-link btn-sm text-decoration-none w-100 mt-1">
                            <i class="bi bi-images me-1"></i>Manage photos
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</div>
